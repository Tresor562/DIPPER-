# ╔══════════════════════════════════════════════════════════════╗
# ║   𝐃𝐚𝐫𝐤 — Variables d'environnement                        ║
# ║   Copiez ce fichier en .env et remplissez les valeurs        ║
# ╚══════════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════
# CONFIGURATION BOT
# ═══════════════════════════════════════════════════
PHONE_NUMBER=22912345678        # Numéro Owner pour les PERMISSIONS uniquement (ne déclenche plus de pairing automatique — voir "API PAIRING" plus bas)
OWNER_NAME=Trésor               # [Phase 3] Utilisé en dernier recours seulement si le nom du compte connecté n'est pas encore disponible — le menu affiche désormais le nom réel du compte WhatsApp connecté
PREFIX=.                        # Préfixe des commandes
SESSION_NAME=auth_info_baileys  # Nom du dossier de session (mono-session)

# ═══════════════════════════════════════════════════
# MODES DU BOT
# ═══════════════════════════════════════════════════
SELF_MODE=true      # true = bot personnel / false = bot semi-public
PUBLIC_MODE=false   # true = tout le monde / false = owner+sudo+premium
GHOSTG_MODE=on      # Mode fantôme
AUTO_BIO=false      # Mise à jour automatique de la bio
ANTICALL=false      # Bloquer les appels
WELCOME_MSG=false   # Message de bienvenue
GOODBYE_MSG=false   # Message d'au-revoir
AUTOREACT=false     # Réaction automatique aux messages

# ═══════════════════════════════════════════════════
# MULTI-SESSION MONGODB (optionnel)
# ═══════════════════════════════════════════════════
# Laissez vide pour le mode mono-session classique.
# Obligatoire pour Railway (filesystem éphémère).
#
# 1. Créer un compte gratuit : https://www.mongodb.com/atlas
# 2. Créer un cluster gratuit (M0)
# 3. Database Access → Créer un utilisateur
# 4. Network Access → Add IP → 0.0.0.0/0 (Railway)
# 5. Connect → Drivers → copier l'URI
#
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
MONGODB_DB=dark_bot

# ═══════════════════════════════════════════════════
# API PAIRING (Phase 4A → Phase 1 stabilisation)
# ═══════════════════════════════════════════════════
# Expose utils/pairingService.js en HTTP (POST /pair, GET /health).
# [Phase 1] Démarre TOUJOURS automatiquement, aucune action manuelle requise.
#
# PORT : NE PAS renseigner manuellement sur un hébergeur "cloud" (Railway,
# Render, Katabump, TeoHéberge...) — ces plateformes définissent PORT
# elles-mêmes et redirigent le trafic public vers cette valeur exacte.
# L'API la lit automatiquement en priorité. Ne la définissez vous-même que
# sur un VPS/Docker où VOUS contrôlez le port exposé.
PORT=
# API_PORT : repli optionnel si PORT n'est pas fourni par l'hébergeur (ex:
# VPS/Docker "à la main"). Ignoré si PORT est défini. Non défini = port par
# défaut 3001.
# Nécessite MONGODB_URI ci-dessus (mode multi-session) pour que POST /pair
# fonctionne — sinon l'API répond 503 NO_MONGODB, elle démarre quand même.
API_PORT=
# Clé partagée optionnelle protégeant /session/status et /session/stop
# (le bot Telegram doit alors envoyer la même valeur, voir
# TelegramBot/.env.example → API_INTERNAL_TOKEN). Non défini = ces deux
# routes restent ouvertes (comportement d'origine).
API_INTERNAL_TOKEN=
# Origine autorisée pour les appels cross-origin (CORS) à POST /pair —
# nécessaire si le site de pairing (ex: sur Vercel) est sur un domaine
# différent de cette API. Non défini = '*' (n'importe quelle origine) ;
# cette API ne pose aucun cookie, un '*' n'est donc pas un risque ici.
# Renseignez un domaine précis (ex: https://mon-site.vercel.app) pour
# restreindre.
CORS_ORIGIN=

# ═══════════════════════════════════════════════════
# BOT TELEGRAM "The Big Dipper"
# ═══════════════════════════════════════════════════
# [SÉPARATION DE PROJETS] Le bot Telegram est maintenant un projet
# indépendant — voir /TelegramBot/.env.example pour sa configuration
# (TELEGRAM_BOT_TOKEN, TELEGRAM_OWNER_ID, etc.). Rien à configurer ici.

# ═══════════════════════════════════════════════════
# AUTRES
# ═══════════════════════════════════════════════════
BANNED_USERS=
